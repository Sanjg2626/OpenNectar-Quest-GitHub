 		return true;
 
+#if defined(__ANDROID__)
+	// Exclude Meta Quest (Horizon OS) internal VR Touch controllers and pointer devices
+	if (n.find("device 0x") != std::string::npos || n.find("oculus") != std::string::npos || n.find("meta quest") != std::string::npos)
+		return true;
+	char guidBuf[64] = { 0 };
+	SDL_JoystickGUID g = SDL_JoystickGetDeviceGUID(index);
+	SDL_JoystickGetGUIDString(g, guidBuf, sizeof(guidBuf));
+	std::string sGuid(guidBuf);
+	if (sGuid.find("3328") != std::string::npos) // Oculus / Meta vendor 0x2833
+		return true;
+
+	// Note: On Android, the Sony DualShock 4 / DualSense is named "Wireless Controller Touchpad"
+	// by Android's InputManager because it combines gamepad, axes, and touchpad.
+	// Only skip touchpad/sensors if it's NOT a real game controller or Wireless Controller!
+	if (n.find("wireless controller") == std::string::npos && n.find("dualshock") == std::string::npos && !SDL_IsGameController(index)) {
+		if (n.find("touchpad") != std::string::npos || n.find("motion sensors") != std::string::npos)
+			return true;
+	}
+#else
 	if (n.find("touchpad") != std::string::npos || n.find("motion sensors") != std::string::npos)
 		return true;
+#endif
 	return false;
 }
 
